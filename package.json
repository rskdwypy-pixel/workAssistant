{
  "name": "work-assistant",
  "version": "1.13.0",
  "description": "AI工作助手 - 智能任务管理和日报生成",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "zentao": "node scripts/zentao-push.mjs",
    "mcp": "node src/mcp/zentao-server.js",
    "test": "node scripts/run-all-tests.cjs",
    "test:real": "node scripts/test-script-scope.cjs && node scripts/test-progress-real.cjs && node scripts/test-priority-real.cjs",
    "version": "node scripts/sync-version.mjs && git add extension/manifest.json extension/newtab.html",
    "release:gitee": "bash scripts/release-gitee.sh"
  },
  "keywords": [
    "ai",
    "task",
    "assistant",
    "daily-report"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "marked": "^12.0.2",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.2",
    "openai": "^4.26.0",
    "uuid": "^9.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "acorn": "^8.19.0",
    "jsdom": "^30.1.2"
  },
  "overrides": {
    "qs": "6.16.1"
  }
}
