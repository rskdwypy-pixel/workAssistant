{
  "name": "work-assistant",
  "version": "1.0.0",
  "description": "AI工作助手 - 智能任务管理和日报生成",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "zentao": "node scripts/zentao-push.mjs",
    "mcp": "node src/mcp/zentao-server.js",
    "setup:auto-start": "bash scripts/install-native-host.sh && bash scripts/install-launchagent.sh",
    "setup:chrome-host": "bash scripts/install-native-host.sh",
    "setup:autostart": "bash scripts/install-launchagent.sh",
    "teardown:auto-start": "bash scripts/uninstall-launchagent.sh",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "ai",
    "task",
    "assistant",
    "daily-report"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.2",
    "openai": "^4.26.0",
    "uuid": "^9.0.1",
    "zod": "^3.25.76"
  }
}
