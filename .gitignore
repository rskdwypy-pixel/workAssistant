# 环境变量（明文绝不入库）
.env
.env.*
!.env.example

# 解密过程可能产生的明文备份，同样禁止入库
.env.bak.*

# 依赖
node_modules/

# 日志
logs/
*.log

# 数据
data/*.json

# 本机环境相关（安装脚本生成，含本机 node 绝对路径）
scripts/.node-path

# 备份（含真实任务数据，勿入库）
data/backups/
# 附件待上传区（真实文件，上传到禅道后自动删除）
data/attachments/
data/*.backup


# 本机工作记忆与运行时数据
.workbuddy/

# 测试产物（自动生成，含本机/内网运行数据）
TEST_REPORT.json
TEST_REPORT.md

# 编辑器
.vscode/
.idea/
*.swp
*.swo

# macOS
.DS_Store


# 打包产物
dist/
