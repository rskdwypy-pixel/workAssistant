# 环境变量
.env

# 依赖
node_modules/

# 日志
logs/
*.log

# 数据
data/*.json

# 本机环境相关（安装脚本生成，含本机 node 绝对路径）
scripts/.node-path

# 备份（含真实任务数据，勿入库）
data/backups/
data/*.backup

# 服务运行时 PID 文件
.service.pid

# 本机工作记忆与运行时数据
.workbuddy/

# 测试产物（自动生成，含本机/内网运行数据）
TEST_REPORT.json
TEST_REPORT.md

# 编辑器
.vscode/
.idea/
*.swp
*.swo

# macOS
.DS_Store

# PM2
.pm2/
