{
  "manifest_version": 3,
  "name": "禅道助手",
  "version": "1.11.1",
  "key": "",
  "description": "禅道助手 - 禅道任务、Bug、日报周报的个人工作台",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "alarms",
    "contextMenus",
    "notifications",
    "storage",
    "nativeMessaging",
    "cookies"
  ],
  "host_permissions": [
    "http://127.0.0.1:3721/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
