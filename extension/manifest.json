{
  "manifest_version": 3,
  "name": "工作助手",
  "version": "1.1.1",
  "key": "",
  "description": "AI工作助手 - 智能任务管理和日报生成",
  "icons": {
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "contextMenus",
    "notifications",
    "storage",
    "nativeMessaging",
    "cookies"
  ],
  "host_permissions": [
    "http://127.0.0.1:3721/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
